#!/bin/bash
set -euo pipefail

PASSIVE_ROOT="{{ zfs_passive_dataset }}"
ACTIVE_ROOT="{{ zfs_active_dataset }}"
PASSIVE_OPENEBS="{{ zfs_passive_openebs_dataset }}"

echo "===================================================="
echo "Promoting Non-OpenEBS Custom Datasets"
echo "===================================================="

# Ensure the active root exists before we start moving things into it
zfs list "$ACTIVE_ROOT" >/dev/null 2>&1 || zfs create -p "$ACTIVE_ROOT"

# Get direct children of the passive root (depth 1). 
# We ignore the root itself.
CHILDREN=$(zfs list -H -o name -d 1 "$PASSIVE_ROOT" | grep -v "^${PASSIVE_ROOT}$" || true)

if [ -z "$CHILDREN" ]; then
  echo "No datasets found in $PASSIVE_ROOT."
  exit 0
fi

for ds in $CHILDREN; do
  # Skip the OpenEBS dataset tree entirely; dr-failover.sh handles it later
  if [ "$ds" == "$PASSIVE_OPENEBS" ]; then
    continue
  fi

  # Calculate the target dataset name
  DS_NAME="${ds##*/}"
  TARGET_DS="$ACTIVE_ROOT/$DS_NAME"

  echo "----------------------------------------------------"
  echo "Processing custom dataset: $ds"

  # Rollback to the latest snapshot to guarantee filesystem integrity.
  # If Syncoid was interrupted mid-transfer during the failure, the live filesystem 
  # might be corrupt. The snapshot is guaranteed to be consistent.
  LATEST_SNAP=$(zfs list -t snapshot -o name -S creation -H -d 1 "$ds" | head -n 1 || true)
  if [ -n "$LATEST_SNAP" ]; then
    echo "  -> Rolling back to safe snapshot: $LATEST_SNAP"
    zfs rollback -r "$LATEST_SNAP"
  fi

  echo "  -> Renaming to: $TARGET_DS"
  zfs rename "$ds" "$TARGET_DS"

  # If you are using standard ZFS mountpoints (not legacy), you may want to ensure it is mounted
  # zfs mount "$TARGET_DS" || true
done

echo "Non-OpenEBS dataset failover complete!"
