#!/bin/bash
set -euo pipefail

BACKUP_POOL="{{ syncoid_source_dataset_staging }}/openebs"
TARGET_POOL="{{ syncoid_source_dataset_openebs }}"

k_exec() { "$RKE2_KUBECTL" --kubeconfig="$RKE2_KUBECONFIG" "$@"; }

echo "===================================================="
echo "Starting DR Failback Adoption (Staging -> Meddle)"
echo "===================================================="
declare -A TARGET_NAMESPACES
declare -A MIGRATION_MAP
declare -A SAVED_PV
declare -A SAVED_ZV
declare -A SAVED_PVC

BACKUP_DATASETS=$(zfs list -H -o name -r "$BACKUP_POOL" | grep "pvc-")

for b_ds in $BACKUP_DATASETS; do
    NS=$(zfs get -H -o value k8s:namespace "$b_ds")
    PVC=$(zfs get -H -o value k8s:pvc "$b_ds")

    if [ "$NS" == "-" ] || [ "$PVC" == "-" ]; then continue; fi

    DUMMY_PV_NAME=$(k_exec get pvc "$PVC" -n "$NS" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)
    if [ -z "$DUMMY_PV_NAME" ]; then continue; fi

    echo "Capturing state for $NS / $PVC -> $DUMMY_PV_NAME"

    SAVED_PV["$b_ds"]=$(k_exec get pv "$DUMMY_PV_NAME" -o json | jq '
        del(.metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp, .metadata.finalizers, 
            .metadata.annotations["pv.kubernetes.io/bind-completed"], .metadata.annotations["pv.kubernetes.io/bound-by-controller"], 
            .metadata.annotations["pv.kubernetes.io/provisioned-by"], .status, 
            .spec.claimRef.uid, .spec.claimRef.resourceVersion)')

    SAVED_ZV["$b_ds"]=$(k_exec get zv "$DUMMY_PV_NAME" -n openebs -o json | jq '
        del(.metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp, .metadata.generation, .status)')

    SAVED_PVC["$b_ds"]=$(k_exec get pvc "$PVC" -n "$NS" -o json | jq '
        del(.metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp, .metadata.finalizers, 
            .metadata.annotations["pv.kubernetes.io/bind-completed"], .metadata.annotations["pv.kubernetes.io/bound-by-controller"], 
            .metadata.annotations["volume.kubernetes.io/selected-node"], .metadata.annotations["volume.beta.kubernetes.io/storage-provisioner"], 
            .status)')

    TARGET_NAMESPACES["$NS"]=1
    MIGRATION_MAP["$b_ds"]="${NS}|${PVC}"
done

echo "===================================================="
echo "Phase 2: Suspend Flux & Wipe Dummy K8s State"
echo "===================================================="
for ns in "${!TARGET_NAMESPACES[@]}"; do
    k_exec patch kustomization --all -n "$ns" --type='merge' -p '{"spec":{"suspend":true}}' || true
done

for b_ds in "${!MIGRATION_MAP[@]}"; do
    IFS='|' read -r NS PVC <<< "${MIGRATION_MAP[$b_ds]}"
    echo "Deleting dummy PVC: $NS/$PVC"
    k_exec delete pvc "$PVC" -n "$NS" --ignore-not-found
done

sleep 5

echo "===================================================="
echo "Phase 3: Snapshot Clone & Mount (Root Execution)"
echo "===================================================="
for b_ds in "${!MIGRATION_MAP[@]}"; do
    IFS='|' read -r NS PVC <<< "${MIGRATION_MAP[$b_ds]}"
    VOL_NAME="${b_ds##*/}"
    TARGET_DS="$TARGET_POOL/$VOL_NAME"
    
    echo "----------------------------------------------------"
    echo "Migrating: $NS / $PVC"
    
    if zfs list "$TARGET_DS" &>/dev/null; then
        zfs destroy -r "$TARGET_DS"
    fi

    LATEST_SNAP=$(zfs list -t snapshot -o name -S creation -H -d 1 "$b_ds" | head -n 1)
    
    # Root execution: Local cloning, promoting, and mounting
    zfs clone "$LATEST_SNAP" "$TARGET_DS"
    zfs promote "$TARGET_DS"

    zfs set k8s:namespace="$NS" "$TARGET_DS"
    zfs set k8s:pvc="$PVC" "$TARGET_DS"
    zfs set mountpoint=legacy "$TARGET_DS"
    
    echo "${SAVED_PV[$b_ds]}" | jq --arg vol "$VOL_NAME" '.metadata.name = $vol | .spec.csi.volumeHandle = $vol' | k_exec apply -f -
    echo "${SAVED_ZV[$b_ds]}" | jq --arg vol "$VOL_NAME" '.metadata.name = $vol' | k_exec apply -f -
    echo "${SAVED_PVC[$b_ds]}" | jq --arg vol "$VOL_NAME" '.spec.volumeName = $vol' | k_exec apply -f -
done

echo "===================================================="
echo "Phase 4: Resume Flux Reconciliations"
echo "===================================================="
for ns in "${!TARGET_NAMESPACES[@]}"; do
    echo "Resuming Flux Kustomizations in: $ns"
    k_exec patch kustomization --all -n "$ns" --type='merge' -p '{"spec":{"suspend":false}}' || true
done

echo "===================================================="
echo "Failback Complete! Meddle is now back online."
echo "===================================================="
